# Copy to .env and fill in. .env is gitignored — it holds your API tokens.
# Every value here can be overridden by a CLI flag for a single run.

# ---- Which sources to audit --------------------------------------------------
# Any combination of: gitlab, github, local
# The same project reachable from several sources is scanned from each one;
# whatever they share deduplicates on lockfile content, so it costs nothing.
SOURCES=gitlab,github,local

# ---- Local projects ----------------------------------------------------------
# Comma-separated roots. Below them the scanner picks up BOTH:
#   - every directory containing a .git  → full history is walked
#   - every lockfile belonging to no repo → current state only, no history
# Required when SOURCES contains "local". When SOURCES has no "local" it stays
# useful: local clones seed the remote clones, so the first run downloads
# almost nothing.
LOCAL_ROOTS=~/projects,~/work

# Comma-separated globs. Two kinds, mixed freely:
#   /abs/path             a local path — matched against a repo and its parents,
#                         so naming a directory excludes everything under it
#   group                 a forge project path — matched the same way, so a
#                         group name excludes every project and subgroup below
#   group/project         one project and nothing else; the match walks up to
#                         the parents, never down into children
#   gitlab:group          the same, restricted to one forge
#   gitlab:group/project  a single project on a single forge. This is the exact
#                         form --dry-run prints, so an entry can be copied
#                         straight out of its output
# lockaudit always excludes its own checkout, whatever is set here.
EXCLUDE_PATHS=

# ---- GitLab ------------------------------------------------------------------
GITLAB_URL=https://gitlab.com
# Personal access token, scopes: read_api + read_repository.
# https://gitlab.com/-/user_settings/personal_access_tokens
GITLAB_TOKEN=

# ---- GitHub ------------------------------------------------------------------
# Personal access token. Classic: `repo`. Fine-grained: Contents + Metadata
# read-only on the repositories you want covered.
# https://github.com/settings/tokens
GITHUB_TOKEN=
# GitHub Enterprise: https://ghe.example.com/api/v3
GITHUB_API_URL=https://api.github.com
# How far "contributed to" is taken. GitHub has no endpoint for "repos I sent a
# PR to without access" — but those contributions live in a fork you own, which
# `owner` already covers.
GITHUB_AFFILIATIONS=owner,collaborator,organization_member

# ---- Coverage ----------------------------------------------------------------
# Archived repos are included by default: an archived repo is exactly where a
# compromised lockfile goes to be forgotten.
INCLUDE_ARCHIVED=1

# Every branch and tag is always walked, not just the default branch, and local
# repos also cover commits only reachable through the reflog (a lockfile you
# rebased away still ran an install when it existed).
# This adds the branches behind merge/pull requests. Off by default: on a repo
# you merely contribute to, those are thousands of other people's branches you
# never installed.
FETCH_ALL_REFS=0

# Walk git history rather than just HEAD. This is the point of the tool: a
# dependency compromised two years ago is invisible on HEAD today.
SCAN_HISTORY=1

# ---- What to report ----------------------------------------------------------
# The MINIMUM severity to report. Everything at that level and above is
# reported; anything below is dropped.
SEVERITY_THRESHOLD=MALWARE

# Where the full Markdown report is written after every run. This is the copy
# you keep: the terminal output is truncated to fit a screen, this one is not.
# Set to "-" to write no file.
REPORT_FILE=lockaudit-report.md

# ---- Performance -------------------------------------------------------------
# Parallel osv-scanner processes. Defaults to the CPU count.
# WORKERS=16
# Parallel git clones. Network-bound, kept separate so clones cannot starve the
# CPU-bound work.
NETWORK_WORKERS=8
# Re-download the OSV databases when they are older than this.
DB_MAX_AGE_HOURS=24
# Disk budget per extraction wave, in MiB. Lockfiles are extracted to scratch
# space under CACHE_DIR and deleted as soon as their wave is scanned.
# 0, the default, means one single wave however big it needs to be — every extra
# wave reloads the OSV databases for its own matching pass, and disk is the cheap
# resource. Set a cap here if it is not: ~11k lockfile versions extracted 2.4 GB.
WAVE_MB=0

# ---- Paths -------------------------------------------------------------------
# Scan results, bare clones and extraction scratch space.
CACHE_DIR=~/.cache/lockaudit
# Override the osv-scanner binary if it is not on PATH.
# OSV_SCANNER_BIN=osv-scanner

# ---- Advanced ----------------------------------------------------------------
# Git pathspecs for the files to look for. Defaults to every lockfile and
# manifest osv-scanner supports; set this only to add a new one without waiting
# for a rebuild. osv-scanner exposes no API to enumerate its own extractors.
# LOCKFILE_PATTERNS=*package-lock.json,*Cargo.lock,*composer.lock
